# English error pages for requests below /blog/en/.
# Kept separate because ErrorDocument is scoped by directory; this avoids a
# redirect, script, language cookie, or fragile request-time expression.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # GTM Preview — نسخة من قاعدة الجذر: RewriteEngine On هنا يُصفّر قواعد
    # الجذر، فبلاها تأخذ صفحات المدونة الترويسات الصارمة حتى في جلسة معاينة
    # فينقطع Tag Assistant عند الانتقال إليها. تضبط متغيّرًا فقط، بلا [L] ولا
    # ترويسات هنا (Header في هذا الملف قد يُسقط المدونة على LiteSpeed).
    RewriteCond %{QUERY_STRING} (^|&)gtm_debug= [OR]
    RewriteCond %{HTTP_COOKIE} (^|;)\s*_{1,2}TAG_ASSISTANT=
    RewriteRule ^ - [E=Z2O_GTM_PREVIEW:1]

    # ----------------------------------------------------------------
    #  اسم المضيف القانوني — يُكرَّر هنا عمدًا، وليس تكرارًا زائدًا.
    #
    #  ‏`RewriteEngine On` في .htaccess فرعي **يُعيد ضبط سياق التحويل**:
    #  قواعد الجذر لا تُورَّث. فبلا هذه القاعدة بقيت المدونة كاملة تُقدَّم
    #  على www بينما تحوّل بقيةُ الموقع — قِسناه: www/blog/en/ ردّ 200
    #  بعد أن صار www/ يردّ 301.
    # ----------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/blog/en/$1 [R=301,L]
    # Add only exact, approved paths. Patterns are relative to /blog/en/.
    # BEGIN verified English 410 rules
    # No English URL has been verified as permanently removed yet.
    # END verified English 410 rules
</IfModule>

ErrorDocument 404 /blog/en/404.html
ErrorDocument 410 /blog/en/404.html
